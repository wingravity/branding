{
  "name": "wingravity-branding",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "wingravity-branding",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=18"
      }
    },
    "node_modules/@wingravity/brand": {
      "resolved": "packages/brand",
      "link": true
    },
    "node_modules/@wingravity/email-signature": {
      "resolved": "packages/email-signature",
      "link": true
    },
    "node_modules/@wingravity/guidelines": {
      "resolved": "packages/guidelines",
      "link": true
    },
    "node_modules/@wingravity/render": {
      "resolved": "packages/render",
      "link": true
    },
    "node_modules/@wingravity/social": {
      "resolved": "packages/social",
      "link": true
    },
    "node_modules/@wingravity/virtual-backgrounds": {
      "resolved": "packages/virtual-backgrounds",
      "link": true
    },
    "packages/brand": {
      "name": "@wingravity/brand",
      "version": "2.0.0",
      "license": "SEE LICENSE IN ../../LICENSE",
      "engines": {
        "node": ">=18"
      }
    },
    "packages/documents": {
      "name": "@wingravity/documents",
      "version": "1.0.0",
      "extraneous": true,
      "dependencies": {
        "@wingravity/render": "*"
      },
      "engines": {
        "node": ">=18"
      }
    },
    "packages/email-signature": {
      "name": "@wingravity/email-signature",
      "version": "1.0.0",
      "dependencies": {
        "@wingravity/render": "*"
      },
      "engines": {
        "node": ">=18"
      }
    },
    "packages/guidelines": {
      "name": "@wingravity/guidelines",
      "version": "1.0.0",
      "dependencies": {
        "@wingravity/render": "*"
      },
      "engines": {
        "node": ">=18"
      }
    },
    "packages/render": {
      "name": "@wingravity/render",
      "version": "1.0.0",
      "dependencies": {
        "@wingravity/brand": "*"
      },
      "engines": {
        "node": ">=18"
      }
    },
    "packages/social": {
      "name": "@wingravity/social",
      "version": "1.0.0",
      "dependencies": {
        "@wingravity/render": "*"
      },
      "engines": {
        "node": ">=18"
      }
    },
    "packages/virtual-backgrounds": {
      "name": "@wingravity/virtual-backgrounds",
      "version": "1.1.0",
      "dependencies": {
        "@wingravity/render": "*"
      },
      "engines": {
        "node": ">=18"
      }
    }
  }
}
